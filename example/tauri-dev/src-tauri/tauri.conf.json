{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reflex Counter",
  "version": "0.1.0",
  "identifier": "dev.reflex.counter",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reflex Counter",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "center": true,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}

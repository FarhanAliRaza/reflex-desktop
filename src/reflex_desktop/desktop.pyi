from collections.abc import Mapping, Sequence
from typing import Any

from reflex.event import EventSpec

def invoke(
    command: str,
    args: Mapping[str, Any] | None = ...,
    *,
    callback: Any = ...,
    convert_keys: bool = ...,
) -> EventSpec: ...
def minimize() -> EventSpec: ...
def maximize() -> EventSpec: ...
def unmaximize() -> EventSpec: ...
def toggle_maximize() -> EventSpec: ...
def close() -> EventSpec: ...
def start_dragging() -> EventSpec: ...
def set_fullscreen(value: bool = ...) -> EventSpec: ...
def set_title(title: str) -> EventSpec: ...
def open_file(
    callback: Any,
    *,
    multiple: bool = ...,
    directory: bool = ...,
    title: str | None = ...,
    filters: Mapping[str, Sequence[str]] | None = ...,
) -> EventSpec: ...
def save_file(
    callback: Any,
    *,
    default_path: str | None = ...,
    title: str | None = ...,
    filters: Mapping[str, Sequence[str]] | None = ...,
) -> EventSpec: ...
def clipboard_write(text: str) -> EventSpec: ...
def clipboard_read(callback: Any) -> EventSpec: ...
def notify(title: str, body: str = ...) -> EventSpec: ...
